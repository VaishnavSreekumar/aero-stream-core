{
  "name": "airbus-digital-aircraft-delivery",
  "version": "1.0.0",
  "description": "Airbus Digital Aircraft Delivery - Telemetry Ingestion & Compliance Pipeline",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix frontend run dev",
    "test:backend": "npm --prefix backend test",
    "test:analytics": "python -m unittest discover -s analytics -p \"test_*.py\"",
    "test": "npm run test:backend && npm run test:analytics",
    "build:frontend": "npm --prefix frontend run build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "airbus",
    "aviation",
    "mode-s",
    "ads-b",
    "telemetry",
    "aircraft-delivery",
    "aerospace",
    "avionics",
    "digital-twin"
  ],
  "author": "Vaishnav Sreekumar",
  "license": "MIT"
}
